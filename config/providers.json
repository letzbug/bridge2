        ],
        "completion_indicator": [
          "button[data-testid=\"copy-turn-action-button\"]",
          "button[data-testid=\"good-response-turn-action-button\"]"
        ],
        "login_required": [
          "button[data-testid=\"login-button\"]",
          "a[href*=\"/auth/login\"]"
