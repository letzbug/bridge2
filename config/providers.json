      "message_id_attributes": [
        "data-message-id"
      ],
      "login_url_patterns": [
        "auth.openai.com",
        "/auth/login",
        "/log-in"
      ],
      "conversation_id_patterns": [
        "/c/([0-9a-fA-F-]{8,})"
      ],
      "input_method": "fill",
      "send_method": "click_or_enter",
      "stability_ms": 1500,
      "max_input_chars": 30000,
      "automation": {
        "policy": "review_terms",
        "note": "OpenAI's consumer Terms of Use restrict automated or programmatic extraction of output from the ChatGPT interface. Review the current terms before enabling automated interaction. The clipboard mode involves no automation."
      },
      "validation": {
        "status": "unvalidated",
        "notes": "Candidates based on publicly known markup. Requires live validation with the adapter diagnostics."
      }
