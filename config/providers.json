{
  "schema_version": 1,
  "_comment": "Selector CANDIDATES. Except for 'mock', none of these were validated against the live websites during development (no account access). Each list is tried in order. Prefer semantic attributes and roles. Local overrides: <data dir>/providers.user.json (edit via Settings > Providers). Syntax: CSS | role:<role>[:<name regex>] | text:<regex> | xpath=<expr>.",
  "generic": {
    "selectors": {
      "input": [
        "textarea",
        "div[contenteditable=\"true\"][role=\"textbox\"]",
        "div[contenteditable=\"true\"]",
        "role:textbox"
      ],
      "send_button": [
        "button[type=\"submit\"]",
        "button[aria-label*=\"Send\" i]",
        "button[aria-label*=\"Senden\" i]",
        "button[aria-label*=\"Envoyer\" i]",
        "role:button:^(send|senden|envoyer|submit)"
      ],
      "assistant_message": [
        "[data-message-author-role=\"assistant\"]",
        "[data-role=\"assistant\"]",
        "[data-author=\"assistant\"]",
        ".assistant-message",
        ".markdown",
        ".prose"
      ],
      "user_message": [
        "[data-message-author-role=\"user\"]",
        "[data-role=\"user\"]",
        ".user-message"
      ],
      "generating": [
        "button[aria-label*=\"Stop\" i]",
        "button[aria-label*=\"Stopp\" i]",
        "button[aria-label*=\"Arrêter\" i]"
      ],
      "stop_button": [
        "button[aria-label*=\"Stop\" i]",
        "button[aria-label*=\"Stopp\" i]",
        "button[aria-label*=\"Arrêter\" i]"
      ],
      "completion_indicator": [],
      "login_required": [],
      "error_banner": [
        "[role=\"alert\"]"
      ]
    },
    "extract_exclude": [
      "button",
      "[aria-hidden=\"true\"]",
      ".sr-only",
      "[data-exclude-from-copy]",
      "svg"
    ],
    "rate_limit_text_patterns": [
      "rate limit",
      "too many requests",
      "usage limit",
      "you've reached",
      "you have reached",
      "limit reached",
      "try again later",
      "zu viele anfragen",
      "limite atteinte",
      "trop de requêtes"
    ]
  },
  "providers": {
